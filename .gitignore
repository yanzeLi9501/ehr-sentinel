# Data files — NEVER commit any patient data
*.csv
*.xlsx
*.xls
*.feather
*.parquet
*.sav
*.dta
*.sas7bdat
*.h5
*.hdf5
*.pkl
*.joblib
# Compressed data archives (e.g. labevents.csv.gz, *.csv.gz.part)
*.gz
*.zip
*.tar
*.tar.gz
*.bz2
*.7z
*.part
# NumPy / database files
*.npy
*.npz
*.db
*.sqlite
validation_outputs/
multi_dataset_validation_results.*

# Allow synthetic-data fixtures explicitly produced by tests/examples
!tests/fixtures/*.csv
!examples/expected_outputs/*.csv

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.env
.venv/
venv/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# IDE
.idea/
.vscode/
*.swp
.DS_Store
